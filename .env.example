# Nemotron Lightning NIM
NEMOTRON_URL=http://localhost:8000/v1
NEMOTRON_MODEL=nemotron-3.5-lightning
NEMOTRON_API_KEY=not-needed

# NVIDIA VSS
VSS_URL=http://localhost:8010
VSS_ENABLED=false

# Data and Output Paths
DATA_DIR=data/SoccerNet
OUTPUT_DIR=output

# Match Engine
MATCH_SPEED_MULTIPLIER=6.0
WINDOW_SIZE_MINUTES=5

# Server
HOST=0.0.0.0
PORT=8080
